<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="PostgresPU" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/PostgresDS</jta-data-source>
    </persistence-unit>

    <persistence-unit name="OraclePU" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/OracleDS</jta-data-source>
    </persistence-unit>

    <persistence-unit name="SqlServerPU" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/SqlServerDS</jta-data-source>
    </persistence-unit>

</persistence>
